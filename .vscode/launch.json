{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "NAF-CSMを起動（接続エラー回避）",
      "type": "pwa-node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "args": [
        "8000",
        "--open-edge"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
